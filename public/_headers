# Cloudflare Pages Edge Cache & Security Rules for petslam.app

# 1. Static Compiled Assets: 1-Month Edge & Browser Cache TTL (Immutable)
/assets/*
  Cache-Control: public, max-age=2592000, immutable
  Access-Control-Allow-Origin: *

# 2. Dynamic API Endpoints: Bypass All Caches
/api/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# 3. Global Security Headers for petslam.app (Discord Activities & Web Compatible)
/*
  X-Content-Type-Options: nosniff
  Content-Security-Policy: frame-ancestors 'self' https://*.discordsays.com https://*.discord.com https://discord.com https://*.cloudflare.com https://www.petslam.app https://petslam.app;
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(self), interest-cohort=()
