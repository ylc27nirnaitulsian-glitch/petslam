# Cloudflare Pages Edge Cache & Security Rules for petslam.app

# 1. Static Compiled Assets: 1-Month Edge & Browser Cache TTL (Immutable)
/assets/*
  Cache-Control: public, max-age=2592000, immutable
  Access-Control-Allow-Origin: *

# 2. Dynamic API Endpoints: Bypass All Caches
/api/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# 3. Global Security Headers for petslam.app
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(), interest-cohort=()
