# ==============================================================================
# PET SLAM: Environment Configuration Template
# For GitHub Pages deployment, add VITE_SUPABASE_URL & VITE_SUPABASE_ANON_KEY
# to your GitHub Repository -> Settings -> Secrets and variables -> Actions
# ==============================================================================

# Supabase Project URL and Public Anon Key
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Transactional Email Provider (Resend)
# Configured in: Supabase Dashboard -> Edge Functions -> Secrets
# (Never expose RESEND_API_KEY to the public frontend!)
RESEND_API_KEY="re_1234567890abcdef..."
RESEND_FROM_EMAIL="PET SLAM <hello@petslam.com>"
