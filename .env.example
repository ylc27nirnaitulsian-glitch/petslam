# ==============================================================================
# PET SLAM: Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Analytics & Tracking: Microsoft Clarity
# ------------------------------------------------------------------------------
# Sign up at: https://clarity.microsoft.com/
# Create a project and grab your Project ID (e.g., "p2xyz123ab")
VITE_CLARITY_PROJECT_ID="your_clarity_project_id_here"

# ------------------------------------------------------------------------------
# 2. Search Engine Indexing: Google Search Console
# ------------------------------------------------------------------------------
# In Google Search Console -> Add Property -> HTML Tag verification method
# Paste the content string from: <meta name="google-site-verification" content="..." />
# Note: PET SLAM also supports automated HTML file verification at:
# https://yourdomain.com/google[code].html
VITE_GOOGLE_SITE_VERIFICATION="your_gsc_verification_code_here"

# ------------------------------------------------------------------------------
# 3. Monetization & Checkout: Dodo Payments (Merchant of Record)
# ------------------------------------------------------------------------------
# Dashboard: https://app.dodopayments.com/
# Developer API Keys: Dashboard -> Developers -> API Keys
# Environment: 'test_mode' for sandbox testing, 'live_mode' for production
DODO_PAYMENTS_API_KEY="your_dodo_api_key_here"
DODO_PAYMENTS_WEBHOOK_SECRET="your_dodo_webhook_secret_here"
DODO_PAYMENTS_ENVIRONMENT="test_mode"

# Optional: Dodo Product IDs from Dashboard (if left blank, defaults are used)
DODO_PRODUCT_AUCTION_PASS="pdt_auction_pass"
DODO_PRODUCT_AVATAR_PASS="pdt_avatar_pass"
DODO_PRODUCT_EXTENSION_PASS="pdt_extension_pass"
DODO_PRODUCT_BUNDLE_PASS="pdt_genesis_bundle"
DODO_PRODUCT_CREDITS_5K="pdt_credits_5k"

# ------------------------------------------------------------------------------
# 4. AI & Cloud Capabilities (Gemini 2.5/3.0 Studio)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your_gemini_api_key_here"

# ------------------------------------------------------------------------------
# 5. Supabase & Transactional Email (Optional)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
RESEND_API_KEY="re_1234567890abcdef..."
RESEND_FROM_EMAIL="PET SLAM <hello@petslam.com>"
